PORT=3001
SITE_URL=http://localhost:5173
PUBLIC_URL=http://localhost:3001
NODE_ENV=development
DATA_DIR=
# Obrigatória no primeiro uso. Use pelo menos 12 caracteres e não envie o arquivo .env ao GitHub.
ADMIN_USER=
ADMIN_PASSWORD=
# As demais variáveis são opcionais e substituem os valores configurados no painel.
AUTH_SECRET=
# Turnstile protege o login administrativo. Crie o widget no Cloudflare e
# configure as duas chaves somente no ambiente (nunca no Git).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Recomendada em produção: chave independente, com 64 caracteres hexadecimais,
# usada para criptografar tokens e credenciais salvos pelo painel.
SECRETS_ENCRYPTION_KEY=
# Opcional: chave hexadecimal de 64 caracteres ou segredo aleatório com 32+ caracteres.
# Use um valor diferente de SECRETS_ENCRYPTION_KEY para criptografar dados pessoais em repouso.
# Se ficar vazio, o sistema gera data/.data-key (não versionar nem apagar).
DATA_ENCRYPTION_KEY=
# Armazenamento. O padrão "file" mantém o banco atual. Só use "postgres"
# depois de criar o banco no Render e preencher DATABASE_URL.
STORE_BACKEND=file
DATABASE_URL=
# Tamanho máximo do conjunto de conexões com o PostgreSQL (recomendado: 5).
PG_POOL_MAX=5
# Para URL externa, use verify-full. Para a URL interna do Render, o sistema
# detecta a rede privada automaticamente. "require" desativa a verificação do certificado.
PGSSL=verify-full
PGSSL_ROOT_CERT=
WORKER_TOKEN=
MERCADO_LIVRE_ACCESS_TOKEN=
SHOPEE_FEED_URL=
WHATSAPP_GROUP_NAME=Nome exato do seu grupo
API_URL=http://localhost:3001
WHATSAPP_HEADLESS=false
WHATSAPP_AUTOSTART=true
WHATSAPP_MAX_PER_HOUR=10
# Opcional: número que receberá os alertas operacionais do servidor pelo WhatsApp.
# Use código do país + DDD + número, somente dígitos (ex.: 5561999999999).
MONITORING_WHATSAPP_RECIPIENT=
CHROME_PATH=
PUPPETEER_SKIP_DOWNLOAD=
# Opcional: substitui a chave e os dados da IA salvos no painel.
AI_API_KEY=
AI_MODEL=
# Opcional: automação experimental para gerar links de afiliado do Mercado Livre.
# Não coloque Cookie ou CSRF reais neste arquivo, pois ele pode ser versionado no GitHub.
MERCADO_LIVRE_AFFILIATE_COOKIE=
MERCADO_LIVRE_AFFILIATE_CSRF_TOKEN=
MERCADO_LIVRE_AFFILIATE_TAG=promoshop

# Formulário de contato (Brevo). Nunca coloque a chave real no GitHub.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=contatopromoshop.site@gmail.com
BREVO_SENDER_NAME=PromoShop
CONTACT_EMAIL=contatopromoshop.site@gmail.com
