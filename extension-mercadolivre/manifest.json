{
  "manifest_version": 3,
  "name": "PromoShop — Ofertas Mercado Livre",
  "version": "0.1.0",
  "description": "Captura uma promoção do Mercado Livre com o link oficial de afiliado e envia ao PromoShop.",
  "icons": { "48": "icons/promoshop-48.png", "128": "icons/promoshop-192.png" },
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://promoshop.jhonatafaraujo.com.br/*", "https://promoshop.onrender.com/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Capturar oferta do Mercado Livre",
    "default_popup": "popup.html",
    "default_icon": { "48": "icons/promoshop-48.png", "128": "icons/promoshop-192.png" }
  },
  "content_scripts": [{
    "matches": ["https://mercadolivre.com.br/*", "https://*.mercadolivre.com.br/*"],
    "js": ["mercadolivre.js"],
    "run_at": "document_idle"
  }]
}
